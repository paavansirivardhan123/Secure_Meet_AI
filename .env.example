# ── Copy this to .env and fill in your values ──────────────────

# Database
DB_NAME=securemeet
DB_USER=securemeet
DB_PASSWORD=change_me_in_production

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_random_256_bit_secret_key_at_least_32_chars_long!!
JWT_EXPIRATION=86400000

# OpenVidu — must match in both services
OPENVIDU_SECRET=change_me_openvidu_secret
DOMAIN=yourdomain.com

# Frontend URL (used for CORS + invite email links)
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com

# Mail (Gmail example — use an App Password, not your real password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
